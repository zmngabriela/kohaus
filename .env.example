# Local development / Cloudflare Pages Preview: use the EXISTING development project.
VITE_APP_ENV=development
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROPERTY_MEDIA_BUCKET=property-media
# Only on Cloudflare Pages Production (main): use production values above, and set:
# VITE_APP_ENV=production
# KOHAUS_EXPECTED_SUPABASE_REF=<new production project ID>
# Never put service_role, secret keys or database passwords in VITE_ variables.

# Enable only after approval in Cloudflare Production; always false in Preview.
VITE_ANALYTICS_ENABLED=false

# Turnstile PUBLIC sitekey; configure the separate secret only in Cloudflare Functions.
VITE_TURNSTILE_SITE_KEY=

# Canonical public origin; same value in production and preview. Change on domain migration.
VITE_SITE_URL=https://kohaus.pages.dev
